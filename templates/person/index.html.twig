{% extends 'base.html.twig' %}

{% block title %}persons{% endblock %}

{% block body %}
    <div class="alert alert-warning">
        <ol class="list-group">
            {% for person in persons %}
            <li class="list-group-item">
                {{ person.name }} a {{ person.age }} ans
                <a href="{{ path('remove_person', {id: person.id}) }}" class="btn btn-danger">
                    delete
                </a>
            </li>
            {% endfor %}
        </ol>
    </div>
{% endblock %}
