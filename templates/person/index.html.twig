{% extends 'base.html.twig' %}

{% block title %}Liste des personnes{% endblock %}

{% block body %}
    <div class="alert alert-info">
        <ol class="list-group">
         {% for person in persons %}
            <li class="list-group-item">
            {{ person.name}} a {{ person.age}} ans
            </li>
         {% endfor %}
        </ol>
    </div>
{% endblock %}
