{% extends 'base.html.twig' %}

{% block title %}Liste des personnes{% endblock %}

{% block body %}
    <a href="{{ path('app_add_person', {id: 0}) }}" class="btn btn-primary">Add Person</a>
    <div class="alert alert-info">
        <ol class="list-group">
         {% for person in persons %}
            <li class="list-group-item">
                <div class="row">
                    <div class="col-3">
                        {{ person.name}} a {{ person.age}} ans
                    </div>
                    <div class="col">
                        <a href="{{ path('app_add_person', {id: person.id}) }}" class="btn btn-success">Edit</a>
                        <a href="{{ path('delete_person', {id: person.id}) }}" class="btn btn-danger">Delete</a>
                        <a href="{{ path('details_person', {id: person.id}) }}" class="btn btn-info">Details</a>
                    </div>
                </div>
            </li>
         {% endfor %}
        </ol>
    </div>
{% endblock %}
